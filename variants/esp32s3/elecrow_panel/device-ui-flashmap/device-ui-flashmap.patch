@@ -76,3 +76,30 @@
 };
 
 #endif
+
+#if defined(MAP_FROM_FLASH)
+#include "esp_partition.h"
+
+/**
+ * Reads the PMTiles archive straight from the raw data partition labelled "maps" (no file system involved)
+ */
+class FlashMapFileSystem : public IMapFileSystem
+{
+  public:
+    bool open(const char *path) override
+    {
+        part = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, (esp_partition_subtype_t)0x40, "maps");
+        return part != nullptr;
+    }
+    void close(void) override {}
+    bool readAt(uint64_t offset, uint8_t *buf, uint32_t len) override
+    {
+        if (!part || offset + len > part->size)
+            return false;
+        return esp_partition_read(part, (size_t)offset, buf, len) == ESP_OK;
+    }
+
+  private:
+    const esp_partition_t *part = nullptr;
+};
+#endif
